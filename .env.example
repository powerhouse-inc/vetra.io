# The homepage is hosted externally and redirects to this URL when accessed
# This environment variable stores the external homepage URL
HOMEPAGE_REMOTE_URL=https://understanding-assistant-316991.framer.app/page

# Switchboard GraphQL API URL (for builder teams and packages)
NEXT_PUBLIC_SWITCHBOARD_URL=https://switchboard.staging.vetra.io/graphql

# Renown API URL (for user profile data + the login redirect)
NEXT_PUBLIC_RENOWN_URL=https://renown-staging.vetra.io

# Cloud switchboard URL — serves cloud environments AND the access-codes
# subgraph behind the early-access gate (defaults to NEXT_PUBLIC_SWITCHBOARD_URL)
# NEXT_PUBLIC_CLOUD_SWITCHBOARD_URL=https://switchboard.staging.vetra.io/graphql

# Housekeeping switchboard URL — the switchboard federating the VetraHousekeeping
# subgraph (studioPowerState / wakeStudio) that the /studio/waking page polls.
# It lives on whichever switchboard hosts the sleeping studios (today: staging),
# NOT the public prod switchboard. Defaults to staging.
# NEXT_PUBLIC_HOUSEKEEPING_SWITCHBOARD_URL=https://switchboard.staging.vetra.io/graphql

# Cloud environments drive ID
NEXT_PUBLIC_CLOUD_DRIVE_ID=powerhouse
NEXT_PUBLIC_REGISTRY_URL=https://registry.dev.vetra.io
NEXT_PUBLIC_USE_PACKAGE_COVER=false

# Studio redirect URL — where users land after completing early access
NEXT_PUBLIC_STUDIO_URL=https://staging.vetra.io/studio

# Max studios/products a user may create. Unset (or 0) = unlimited. Prod sets 3.
# Client-side UI gate only. e.g. NEXT_PUBLIC_MAX_STUDIOS_PER_USER=3
# NEXT_PUBLIC_MAX_STUDIOS_PER_USER=